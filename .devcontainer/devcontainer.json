{
  "name": "clang-p2996 Qt Dev",
  //"version": "0.2.0",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "type=bind,source=${localWorkspaceFolder},target=/workspace,consistency=cached",
  "containerEnv": {
    "CC": "/opt/clang-p2996/bin/clang",
    "CXX": "/opt/clang-p2996/bin/clang++"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "C_Cpp.default.compilerPath": "/opt/clang-p2996/bin/clang",
        "cmake.generator": "Ninja",
        "cmake.configureSettings": {
          "CMAKE_C_COMPILER": "/opt/clang-p2996/bin/clang",
          "CMAKE_CXX_COMPILER": "/opt/clang-p2996/bin/clang++"
        }
      }
    }
  },
  "remoteUser": "root"
}